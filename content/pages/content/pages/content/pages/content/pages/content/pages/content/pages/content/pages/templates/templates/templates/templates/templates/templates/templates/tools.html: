<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{SEO_TITLE}}</title>
<meta name="description" content="{{SEO_DESCRIPTION}}">
<link rel="icon" href="logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<header class="site-header">
  <div class="container nav-wrap">
    <a href="index.html" class="brand">
      <img src="logo.png" alt="Herbal Impact logo">
      <span>Herbal Impact<br><small>NATURE-BACKED WELLNESS</small></span>
    </a>
    <button class="menu-toggle" aria-label="Toggle menu">&#9776;</button>
    <nav class="main-nav">
      <a href="index.html">Home</a>
      <a href="about.html">About</a>
      <a href="store.html">Store</a>
      <a href="downloads.html">Free Downloads</a>
      <a href="blog.html">Blog</a>
      <a href="tools.html" class="active">Tools</a>
      <a href="videos.html">Videos</a>
      <a href="contact.html">Contact</a>
    </nav>
  </div>
</header>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow" style="background:rgba(255,255,255,0.15);">{{HERO_EYEBROW}}</span>
    <h1>{{HERO_TITLE}}</h1>
    <p>{{HERO_TEXT}}</p>
  </div>
</section>

<section class="section">
  <div class="container">

    <div class="card tool-card">
      <h3>{{BMI_TITLE}}</h3>
      <p>{{BMI_TEXT}}</p>
      <form id="bmi-form">
        <div class="radio-row">
          <label><input type="radio" name="bmi-unit" value="metric" checked> Metric (cm, kg)</label>
          <label><input type="radio" name="bmi-unit" value="imperial"> Imperial (in, lb)</label>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for="bmi-height">Height</label>
            <input type="number" step="any" id="bmi-height" required>
          </div>
          <div class="field">
            <label for="bmi-weight">Weight</label>
            <input type="number" step="any" id="bmi-weight" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Calculate BMI</button>
      </form>
      <div class="result" id="bmi-result" style="display:none;"></div>
      <script>
        document.getElementById('bmi-form').addEventListener('submit', function(){
          document.getElementById('bmi-result').style.display = 'block';
        });
      </script>
    </div>

    <div class="card tool-card">
      <h3>{{PLAN_TITLE}}</h3>
      <p>{{PLAN_TEXT}}</p>
      <form id="plan-form">
        <div class="form-grid">
          <div class="field">
            <label for="plan-currency">Currency</label>
            <input type="text" id="plan-currency" value="USD" required>
          </div>
          <div class="field">
            <label for="plan-amount">Loan / amount</label>
            <input type="number" step="any" id="plan-amount" required>
          </div>
          <div class="field full">
            <label for="plan-term">Term (months)</label>
            <input type="number" id="plan-term" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Build schedule</button>
      </form>
      <div id="plan-result-wrap"></div>
    </div>

    <div class="card tool-card">
      <h3>{{LOAN_TITLE}}</h3>
      <p>{{LOAN_TEXT}}</p>
      <form id="loan-form">
        <div class="form-grid">
          <div class="field">
            <label for="loan-currency">Currency</label>
            <input type="text" id="loan-currency" value="USD" required>
          </div>
          <div class="field">
            <label for="loan-amount">Loan / amount</label>
            <input type="number" step="any" id="loan-amount" required>
          </div>
          <div class="field">
            <label for="loan-term">Term (months)</label>
            <input type="number" id="loan-term" required>
          </div>
          <div class="field">
            <label for="loan-rate">Annual interest rate (%)</label>
            <input type="number" step="any" id="loan-rate" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Build schedule</button>
      </form>
      <div id="loan-result-wrap"></div>
    </div>

    <p class="small">{{DISCLAIMER}}</p>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand" style="color:#fff;margin-bottom:12px;"><img src="logo.png" alt="Herbal Impact logo" style="height:40px"></div>
        <p class="small" style="color:#c8ddcd">Nature-backed wellness, made simple. Herbal products, recipes and free resources rooted in tradition.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="about.html">About</a></li>
          <li><a href="blog.html">Blog</a></li>
          <li><a href="tools.html">Tools</a></li>
          <li><a href="videos.html">Videos</a></li>
        </ul>
      </div>
      <div>
        <h4>Shop</h4>
        <ul>
          <li><a href="store.html">Store</a></li>
          <li><a href="downloads.html">Free Downloads</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Stay in touch</h4>
        <form data-static-form data-success-message="Thanks for subscribing!">
          <div class="field">
            <input type="email" placeholder="Your email" required>
          </div>
          <button class="btn btn-primary" type="submit">Subscribe</button>
          <p class="form-message small" style="display:none;color:#fff"></p>
        </form>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; 2026 Herbal Impact. All rights reserved. | Dar es Salaam, Tanzania
    </div>
  </div>
</footer>

<script src="script.js"></script>
</body>
</html>
